{
  email admin@twidu.com
  servers {
    protocols h1 h2
  }
}

fr2.levospeed.click {
  header Alt-Svc "clear"

  handle /media/v3/fr2/ws* {
    reverse_proxy 127.0.0.1:18094 {
      header_up Host {host}
      flush_interval -1
      transport http {
        versions 1.1
      }
    }
  }

  handle {
    reverse_proxy h2c://127.0.0.1:18093
  }
}
