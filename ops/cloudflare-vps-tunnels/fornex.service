[Unit]
Description=Levospeed Cloudflare Tunnel Fornex
After=network-online.target xray-cloudflare-ws.service
Wants=network-online.target
Requires=xray-cloudflare-ws.service

[Service]
Type=simple
ExecStart=/usr/local/bin/cloudflared tunnel --config /etc/cloudflared/levocf.yml run 32539081-6ad5-4ae1-b2ad-0f05b8feec36
Restart=always
RestartSec=5
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
